DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourdomain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.example
DJANGO_DB_PATH=/var/data/db.sqlite3
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=ProgressPilot <no-reply@yourdomain.example>
DJANGO_EMAIL_HOST=smtp.your-provider.example
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-smtp-user
DJANGO_EMAIL_HOST_PASSWORD=your-smtp-password
DJANGO_EMAIL_USE_TLS=1
